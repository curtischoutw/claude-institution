{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -fr /)",
      "Bash(rm -fr ~)",
      "Bash(rm -r /)",
      "Bash(rm -r ~)",
      "Bash(rmdir /)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf ~)"
    ],
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/<username>/.claude/hooks/rm_guard.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "machine-learning-ops@claude-code-workflows": true,
    "data-engineering@claude-code-workflows": true,
    "python-development@claude-code-workflows": true,
    "llm-application-dev@claude-code-workflows": true,
    "frontend-mobile-development@claude-code-workflows": true,
    "javascript-typescript@claude-code-workflows": true,
    "game-development@claude-code-workflows": true,
    "backend-development@claude-code-workflows": true,
    "llm-finetuning@claude-code-workflows": true,
    "multi-platform-apps@claude-code-workflows": true,
    "ui-design@claude-code-workflows": true,
    "kubernetes-operations@claude-code-workflows": true,
    "observability-monitoring@claude-code-workflows": true
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "language": "繁體中文台灣用語",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" },
    "claude-sonnet-5-5": { "effortLevel": "high" }
  },
  "tui": "fullscreen",
  "switchModelsOnFlag": true
}
